# Copy to .env and fill in real values. Never commit .env.

# Required — better-auth
BETTER_AUTH_SECRET=your_auth_secret
BETTER_AUTH_URL=http://localhost:3000

# Required — MongoDB (name must be MONGODB_URI; mongodb.ts throws without it)
MONGODB_URI=mongodb://localhost:27017
# Must match BookNook-Server/.env — capital B/N; existing users live here
MONGODB_DB=BookNook

# Optional — Google social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Express API (BookNook-Server), defaults to http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional — book cover upload on /add-book (imgbb); upload disabled if unset
NEXT_PUBLIC_IMGBB_API_KEY=
